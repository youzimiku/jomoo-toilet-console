<Window x:Class="JomooRemote.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="九牧 SQ9650 智控中心" Icon="app.ico"
        Width="1240" Height="800" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize" FontFamily="Microsoft YaHei UI">
  <Window.Resources>
    <Style x:Key="Tile" TargetType="Border">
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Background" Value="#0FFFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="#12FFFFFF" />
      <Setter Property="Cursor" Value="Hand" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#1AFFFFFF" />
          <Setter Property="BorderBrush" Value="#24FFFFFF" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="TileState" TargetType="Border">
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Background" Value="#0FFFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="#12FFFFFF" />
      <Setter Property="Cursor" Value="Hand" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="on">
          <Setter Property="Background" Value="#1757C8FF" />
          <Setter Property="BorderBrush" Value="#3D57C8FF" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="off">
          <Setter Property="Background" Value="#0FFFFFFF" />
          <Setter Property="BorderBrush" Value="#12FFFFFF" />
        </DataTrigger>
        <MultiDataTrigger>
          <MultiDataTrigger.Conditions>
            <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="on" />
            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
          </MultiDataTrigger.Conditions>
          <Setter Property="Background" Value="#2857C8FF" />
          <Setter Property="BorderBrush" Value="#6657C8FF" />
        </MultiDataTrigger>
        <MultiDataTrigger>
          <MultiDataTrigger.Conditions>
            <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="off" />
            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
          </MultiDataTrigger.Conditions>
          <Setter Property="Background" Value="#1CFFFFFF" />
          <Setter Property="BorderBrush" Value="#2EFFFFFF" />
        </MultiDataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="SmallTile" TargetType="Border">
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Background" Value="#0FFFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="#12FFFFFF" />
      <Setter Property="Cursor" Value="Hand" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#1AFFFFFF" />
          <Setter Property="BorderBrush" Value="#24FFFFFF" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="GlassSlider" TargetType="Slider">
      <Setter Property="Height" Value="16" />
      <Setter Property="IsMoveToPointEnabled" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid VerticalAlignment="Center">
              <Border Height="4" CornerRadius="2" Background="#22FFFFFF" VerticalAlignment="Center" />
              <Track x:Name="PART_Track" VerticalAlignment="Center">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4" CornerRadius="2" Background="#57C8FF" VerticalAlignment="Center" />
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Width="12" Height="12" VerticalAlignment="Center">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Ellipse Width="12" Height="12" Fill="#EAF6FF" />
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4" Background="Transparent" VerticalAlignment="Center" />
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SegCell" TargetType="Border">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="#00FFFFFF" />
      <Setter Property="Cursor" Value="Hand" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#1CFFFFFF" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="PanelBtn" TargetType="Border">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="#0FFFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="#1FFFFFFF" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Height" Value="36" />
      <Setter Property="Padding" Value="18,0" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#1CFFFFFF" />
          <Setter Property="BorderBrush" Value="#2EFFFFFF" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid x:Name="ScaleHost">
    <Border x:Name="Backdrop" CornerRadius="28" BorderThickness="1" BorderBrush="#26FFFFFF">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#FF14202C" Offset="0" />
          <GradientStop Color="#FF0B1219" Offset="0.55" />
          <GradientStop Color="#FF070A0E" Offset="1" />
        </LinearGradientBrush>
      </Border.Background>
    </Border>

    <Grid>
      <Grid Margin="24,0,24,20">
        <Grid.RowDefinitions>
          <RowDefinition Height="54" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
          <Border x:Name="DragBar" Height="54" VerticalAlignment="Top" Background="Transparent"
                  MouseLeftButtonDown="DragWindow" />

          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,0,0" IsHitTestVisible="False">
            <TextBlock Text="JOMOO" FontFamily="Bahnschrift" FontSize="19" FontWeight="SemiBold"
                       Foreground="#EDF4FA" VerticalAlignment="Center" />
            <TextBlock Text="智控中心" FontSize="12" Foreground="#7C93A6" Margin="12,0,0,0" VerticalAlignment="Center" />
            <Border CornerRadius="9" BorderThickness="1" BorderBrush="#1EFFFFFF" Padding="8,2" Margin="14,0,0,0" VerticalAlignment="Center">
              <TextBlock x:Name="TagModel" Text="型号待识别" FontSize="10" Foreground="#8FA6B8" />
            </Border>
            <TextBlock x:Name="VersionText" Text="v1.1" FontSize="10" Foreground="#6F8698"
                       Margin="10,1,0,0" VerticalAlignment="Center" />
          </StackPanel>

          <Border x:Name="CloseButton" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,0,0"
                  Width="34" Height="34" CornerRadius="10" Background="#14FFFFFF"
                  BorderThickness="1" BorderBrush="#1FFFFFFF" Cursor="Hand"
                  PreviewMouseLeftButtonDown="TileDown" MouseLeftButtonUp="CloseClick">
            <Canvas Width="12" Height="12">
              <Line X1="0" Y1="0" X2="12" Y2="12" Stroke="#AFC4D4" StrokeThickness="1.4" />
              <Line X1="12" Y1="0" X2="0" Y2="12" Stroke="#AFC4D4" StrokeThickness="1.4" />
            </Canvas>
          </Border>

          <Border x:Name="GearButton" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,58,0"
                  Width="34" Height="34" CornerRadius="10" Background="#14FFFFFF"
                  BorderThickness="1" BorderBrush="#1FFFFFFF" Cursor="Hand"
                  PreviewMouseLeftButtonDown="TileDown" MouseLeftButtonUp="GearClick">
            <Canvas Width="14" Height="14">
              <Ellipse Width="9" Height="9" Stroke="#AFC4D4" StrokeThickness="1.2" Canvas.Left="2.5" Canvas.Top="2.5" />
              <Line X1="11.8" Y1="7" X2="13.6" Y2="7" Stroke="#AFC4D4" StrokeThickness="1.6" />
              <Line X1="10.4" Y1="10.4" X2="11.7" Y2="11.7" Stroke="#AFC4D4" StrokeThickness="1.6" />
              <Line X1="7" Y1="11.8" X2="7" Y2="13.6" Stroke="#AFC4D4" StrokeThickness="1.6" />
              <Line X1="3.6" Y1="10.4" X2="2.3" Y2="11.7" Stroke="#AFC4D4" StrokeThickness="1.6" />
              <Line X1="2.2" Y1="7" X2="0.4" Y2="7" Stroke="#AFC4D4" StrokeThickness="1.6" />
              <Line X1="3.6" Y1="3.6" X2="2.3" Y2="2.3" Stroke="#AFC4D4" StrokeThickness="1.6" />
              <Line X1="7" Y1="2.2" X2="7" Y2="0.4" Stroke="#AFC4D4" StrokeThickness="1.6" />
              <Line X1="10.4" Y1="3.6" X2="11.7" Y2="2.3" Stroke="#AFC4D4" StrokeThickness="1.6" />
            </Canvas>
          </Border>
        </Grid>

        <Grid Grid.Row="1" Margin="0,8,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="386" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Grid Grid.Column="0">
            <Grid.RowDefinitions>
              <RowDefinition Height="420" />
              <RowDefinition Height="16" />
              <RowDefinition Height="264" />
            </Grid.RowDefinitions>

            <Border x:Name="ReadoutCard" Grid.Row="0" CornerRadius="20" BorderThickness="1" BorderBrush="#18FFFFFF">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                  <GradientStop Color="#1FFFFFFF" Offset="0" />
                  <GradientStop Color="#10FFFFFF" Offset="1" />
                </LinearGradientBrush>
              </Border.Background>

              <Grid Margin="22,18,22,18">
                <Grid.RowDefinitions>
                  <RowDefinition Height="20" />
                  <RowDefinition Height="10" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="12" />
                  <RowDefinition Height="1" />
                  <RowDefinition Height="12" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="当前状态" FontSize="13" Foreground="#8FA6B8" VerticalAlignment="Center" />

                <StackPanel Grid.Row="2" Orientation="Horizontal">
                  <TextBlock x:Name="StatusBig" Text="待机" FontFamily="Bahnschrift" FontSize="44"
                             Foreground="#F3F8FC" VerticalAlignment="Center" />
                  <Border x:Name="RunChip" Visibility="Collapsed" CornerRadius="9" Background="#1A57C8FF"
                          BorderThickness="1" BorderBrush="#3D57C8FF" Padding="8,3" Margin="12,10,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="RunChipText" Text="进行中" FontSize="10" Foreground="#8FDCFA" />
                  </Border>
                </StackPanel>

                <TextBlock x:Name="StatusSub" Grid.Row="3" Text="等待连接 · 点任意按钮自动连"
                           FontSize="13" Foreground="#7C93A6" Margin="0,6,0,0" />

                <Border Grid.Row="5" Background="#10FFFFFF" />

                <Grid Grid.Row="7">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>

                  <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="1" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="1" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="*" />
                      <RowDefinition Height="1" />
                      <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                      <TextBlock Text="盖板" FontSize="11" Foreground="#6F8698" />
                      <TextBlock x:Name="ValCover" Text="—" FontSize="19" Foreground="#DCE9F3" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Margin="16,0,0,0">
                      <TextBlock Text="座圈" FontSize="11" Foreground="#6F8698" />
                      <TextBlock x:Name="ValRing" Text="—" FontSize="19" Foreground="#DCE9F3" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="4" VerticalAlignment="Center" Margin="16,0,0,0">
                      <TextBlock Text="座温" FontSize="11" Foreground="#6F8698" />
                      <TextBlock x:Name="ValTemp" Text="—" FontSize="19" Foreground="#DCE9F3" Margin="0,5,0,0" />
                    </StackPanel>

                    <Border Grid.Row="1" Grid.ColumnSpan="5" Background="#0FFFFFFF" />

                    <StackPanel Grid.Row="2" Grid.Column="0" VerticalAlignment="Center">
                      <TextBlock Text="夜灯" FontSize="11" Foreground="#6F8698" />
                      <TextBlock x:Name="ValNight" Text="—" FontSize="19" Foreground="#DCE9F3" Margin="0,5,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" Margin="16,0,0,0">
                      <TextBlock Text="着座" FontSize="11" Foreground="#6F8698" />
                      <TextBlock x:Name="ValSit" Text="—" FontSize="19" Foreground="#DCE9F3" Margin="0,5,0,0" />
                    </StackPanel>

                    <Border x:Name="FaultCell" Grid.Row="2" Grid.Column="4" Margin="16,0,0,0" Background="Transparent"
                            MouseEnter="FaultEnter" MouseLeave="FaultLeave">
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="故障" FontSize="11" Foreground="#6F8698" />
                        <TextBlock x:Name="FaultVal" Text="正常" FontSize="17" Foreground="#3EE08F" Margin="0,5,0,0" />
                      </StackPanel>
                    </Border>

                    <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" Background="#0FFFFFFF" Margin="0,4,0,4" />
                    <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="3" Background="#0FFFFFFF" Margin="0,4,0,4" />
                  </Grid>

                  <Border x:Name="WaterStrip" Grid.Row="1" Height="46" CornerRadius="13" Margin="0,10,0,0"
                          Background="#0CFFFFFF" BorderThickness="1" BorderBrush="#14FFFFFF">
                    <Grid Margin="14,0,14,0" VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="WaterDot" Width="7" Height="7" Fill="#3EE08F" VerticalAlignment="Center" />
                        <TextBlock Text="水箱" FontSize="11" Foreground="#6F8698" Margin="10,0,0,0" VerticalAlignment="Center" />
                      </StackPanel>
                      <TextBlock x:Name="WaterVal" Text="—" FontSize="14" Foreground="#DCE9F3"
                                 HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                </Grid>
              </Grid>
            </Border>

            <Border Grid.Row="2" CornerRadius="18" BorderThickness="1" BorderBrush="#18FFFFFF">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                  <GradientStop Color="#18FFFFFF" Offset="0" />
                  <GradientStop Color="#0CFFFFFF" Offset="1" />
                </LinearGradientBrush>
              </Border.Background>

              <Grid Margin="20,16,20,16">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="14" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border x:Name="ConnBar" CornerRadius="12" Background="#0F3EE08F" BorderThickness="1" BorderBrush="#333EE08F" Padding="10,6">
                  <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <Ellipse x:Name="ConnDot" Width="7" Height="7" Fill="#3EE08F" VerticalAlignment="Center" />
                      <TextBlock x:Name="ConnText" Text="未连接" FontSize="12" FontWeight="SemiBold" Foreground="#BEEBD4"
                                 Margin="9,0,0,0" VerticalAlignment="Center" />
                      <TextBlock x:Name="ConnSub" Text="· 空闲 30 s" FontSize="11" Foreground="#7FB79B"
                                 Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <Border x:Name="ConnAction" HorizontalAlignment="Right" VerticalAlignment="Center"
                            CornerRadius="9" Background="#24FFFFFF" BorderThickness="1" BorderBrush="#33FFFFFF"
                            Padding="10,3" Cursor="Hand"
                            PreviewMouseLeftButtonDown="TileDown" MouseLeftButtonUp="ConnActionClick">
                      <TextBlock x:Name="ConnActionText" Text="重新连接" FontSize="11" Foreground="#E7EFF6" />
                    </Border>
                  </Grid>
                </Border>

                <Grid Grid.Row="2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                  </Grid.RowDefinitions>

                  <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="型号" FontSize="10" Foreground="#6F8698" />
                    <TextBlock x:Name="DevModel" Text="识别中…" FontSize="12" Foreground="#C9D8E4" Margin="0,4,0,0" />
                  </StackPanel>
                  <StackPanel Grid.Row="0" Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="信号强度" FontSize="10" Foreground="#6F8698" />
                    <TextBlock x:Name="DevSig" Text="—" FontSize="12" Foreground="#C9D8E4" Margin="0,4,0,0" />
                  </StackPanel>

                  <StackPanel Grid.Row="1" Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="蓝牙地址" FontSize="10" Foreground="#6F8698" />
                    <TextBlock x:Name="DevAddr" Text="—" FontSize="12" Foreground="#C9D8E4" Margin="0,4,0,0" />
                  </StackPanel>
                  <StackPanel Grid.Row="1" Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="往返时延" FontSize="10" Foreground="#6F8698" />
                    <TextBlock x:Name="DevRtt" Text="—" FontSize="12" Foreground="#C9D8E4" Margin="0,4,0,0" />
                  </StackPanel>
                </Grid>
              </Grid>
            </Border>
          </Grid>

          <Grid Grid.Column="2">
            <Grid.RowDefinitions>
              <RowDefinition Height="460" />
              <RowDefinition Height="18" />
              <RowDefinition Height="108" />
              <RowDefinition Height="18" />
              <RowDefinition Height="96" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="18" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>

              <Border x:Name="BtnCover" Grid.Row="0" Grid.Column="0" Style="{StaticResource TileState}"
                      PreviewMouseLeftButtonDown="TileDown" MouseLeftButtonUp="CoverClick">
                <Grid VerticalAlignment="Center">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Grid Grid.Row="0" Height="50" HorizontalAlignment="Center">
                    <Rectangle x:Name="CoverIconRect" Width="46" Height="34" RadiusX="7" RadiusY="7"
                               Stroke="#7C93A6" StrokeThickness="1.5" VerticalAlignment="Bottom" />
                    <Rectangle x:Name="CoverIconBand" Width="46" Height="9" RadiusX="7" RadiusY="7"
                               Fill="#7C93A6" VerticalAlignment="Bottom" Margin="0,0,0,25" />
                  </Grid>
                  <TextBlock x:Name="CoverLabel" Grid.Row="1" Text="开盖" FontSize="22" FontWeight="SemiBold"
                             Foreground="#E9F4FB" HorizontalAlignment="Center" Margin="0,12,0,0" />
                  <TextBlock x:Name="CoverState" Grid.Row="2" Text="当前 · —" FontSize="12"
                             Foreground="#6F8698" HorizontalAlignment="Center" Margin="0,6,0,0" />
                </Grid>
              </Border>

              <Border x:Name="BtnRing" Grid.Row="0" Grid.Column="2" Style="{StaticResource TileState}"
                      PreviewMouseLeftButtonDown="TileDown" MouseLeftButtonUp="RingClick">
                <Grid VerticalAlignment="Center">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Grid Grid.Row="0" Height="50" Width="40" HorizontalAlignment="Center">
                    <Ellipse x:Name="RingIcon" Width="40" Height="40" VerticalAlignment="Bottom"
                             Stroke="#7C93A6" StrokeThickness="1.5" />
                  </Grid>
                  <TextBlock x:Name="RingLabel" Grid.Row="1" Text="开圈" FontSize="22" FontWeight="SemiBold"
                             Foreground="#E9F4FB" HorizontalAlignment="Center" Margin="0,12,0,0" />
                  <TextBlock x:Name="RingState" Grid.Row="2" Text="当前 · —" FontSize="12"
                             Foreground="#6F8698" HorizontalAlignment="Center" Margin="0,6,0,0" />
                </Grid>
              </Border>

              <Border x:Name="BtnBig" Grid.Row="0" Grid.Column="4" Style="{StaticResource Tile}"
                      PreviewMouseLeftButtonDown="TileDown" MouseLeftButtonUp="BigClick">
                <Grid VerticalAlignment="Center">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Canvas Grid.Row="0" Width="44" Height="48" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                    <Path Data="M 22,2 C 27,10 34,19 34,26 C 34,33 28,38 22,38 C 16,38 10,33 10,26 C 10,19 17,10 22,2 Z" Fill="#8FB9CE" />
                    <Path Data="M 6,45 Q 11,41 16,45 Q 21,49 26,45 Q 31,41 36,45" Stroke="#5F8698" StrokeThickness="1.3" />
                  </Canvas>
                  <TextBlock x:Name="BigLabel" Grid.Row="1" Text="大冲" FontSize="22" FontWeight="SemiBold" Foreground="#DDE8F1"
                             HorizontalAlignment="Center" Margin="0,12,0,0" />
                  <TextBlock x:Name="BigState" Grid.Row="2" Text="满水强冲" FontSize="12" Foreground="#6F8698"
                             HorizontalAlignment="Center" Margin="0,6,0,0" />
                </Grid>
              </Border>

              <Border x:Name="BtnSmall" Grid.Row="2" Grid.Column="0" Style="{StaticResource Tile}"
                      PreviewMouseLeftButtonDown="TileDown" MouseLeftButtonUp="SmallClick">
                <Grid VerticalAlignment="Center">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Canvas Grid.Row="0" Width="44" Height="48" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                    <Path Data="M 22,5 C 26,12 31,19 31,25 C 31,31 27,35 22,35 C 17,35 13,31 13,25 C 13,19 18,12 22,5 Z"
                          Stroke="#8FB9CE" StrokeThickness="1.6" />
                    <Path Data="M 10,45 Q 16,41 22,45 Q 28,49 34,45" Stroke="#5F8698" StrokeThickness="1.3" />
                  </Canvas>
                  <TextBlock x:Name="SmallLabel" Grid.Row="1" Text="小冲" FontSize="22" FontWeight="SemiBold" Foreground="#DDE8F1"
                             HorizontalAlignment="Center" Margin="0,12,0,0" />
                  <TextBlock x:Name="SmallState" Grid.Row="2" Text="半水轻冲" FontSize="12" Foreground="#6F8698"
                             HorizontalAlignment="Center" Margin="0,6,0,0" />
                </Grid>
              </Border>

              <Border x:Name="BtnBubble" Grid.Row="2" Grid.Column="2" Style="{StaticResource Tile}"
                      PreviewMouseLeftButtonDown="TileDown" MouseLeftButtonUp="BubbleClick">
                <Grid VerticalAlignment="Center">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Canvas Grid.Row="0" Width="44" Height="44" HorizontalAlignment="Center">
                    <Ellipse Canvas.Left="2" Canvas.Top="24" Width="13" Height="13" Fill="#2C4657" />
                    <Ellipse Canvas.Left="16" Canvas.Top="26" Width="11" Height="11" Fill="#35576A" />
                    <Ellipse Canvas.Left="29" Canvas.Top="23" Width="13" Height="13" Fill="#2C4657" />
                    <Ellipse Canvas.Left="10" Canvas.Top="13" Width="15" Height="15" Fill="#35576A" />
                    <Ellipse Canvas.Left="26" Canvas.Top="9" Width="11" Height="11" Fill="#2C4657" />
                  </Canvas>
                  <TextBlock x:Name="BubbleLabel" Grid.Row="1" Text="魔力泡" FontSize="22" FontWeight="SemiBold" Foreground="#DDE8F1"
                             HorizontalAlignment="Center" Margin="0,12,0,0" />
                  <TextBlock x:Name="BubbleState" Grid.Row="2" Text="泡沫隔臭" FontSize="12" Foreground="#6F8698"
                             HorizontalAlignment="Center" Margin="0,6,0,0" />
                </Grid>
              </Border>

              <Border x:Name="BtnNight" Grid.Row="2" Grid.Column="4" Style="{StaticResource TileState}"
                      PreviewMouseLeftButtonDown="TileDown" MouseLeftButtonUp="NightClick">
                <Grid VerticalAlignment="Center">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Canvas Grid.Row="0" Width="44" Height="44" HorizontalAlignment="Center">
                    <Path x:Name="NightIconShade" Data="M 13,13 L 31,13 L 40,37 L 4,37 Z" Fill="#228FB9CE" />
                    <Rectangle x:Name="NightIconBar" Canvas.Left="13" Canvas.Top="6" Width="18" Height="6" RadiusX="3" RadiusY="3" Fill="#7C93A6" />
                    <Line X1="6" Y1="40" X2="38" Y2="40" Stroke="#4A6B7E" StrokeThickness="1.2" />
                  </Canvas>
                  <TextBlock x:Name="NightLabel" Grid.Row="1" Text="夜灯" FontSize="22" FontWeight="SemiBold" Foreground="#DDE8F1"
                             HorizontalAlignment="Center" Margin="0,12,0,0" />
                  <TextBlock x:Name="NightState" Grid.Row="2" Text="当前 · —" FontSize="12" Foreground="#6F8698"
                             HorizontalAlignment="Center" Margin="0,6,0,0" />
                </Grid>
              </Border>
            </Grid>

            <Grid Grid.Row="2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <Border x:Name="Temp0" Grid.Column="0" Style="{StaticResource TileState}" Uid="0"
                      PreviewMouseLeftButtonDown="TileDown" MouseLeftButtonUp="TempClick" Tag="off">
                <StackPanel VerticalAlignment="Center">
                  <TextBlock x:Name="TempTitle0" Text="常温" FontSize="19" Foreground="#CFDDE8" HorizontalAlignment="Center" />
                  <TextBlock Text="档位 0" FontSize="11" Foreground="#6F8698" HorizontalAlignment="Center" Margin="0,5,0,0" />
                </StackPanel>
              </Border>
              <Border x:Name="Temp1" Grid.Column="2" Style="{StaticResource TileState}" Uid="3"
                      PreviewMouseLeftButtonDown="TileDown" MouseLeftButtonUp="TempClick" Tag="off">
                <StackPanel VerticalAlignment="Center">
                  <TextBlock x:Name="TempTitle1" Text="中温" FontSize="19" Foreground="#CFDDE8" HorizontalAlignment="Center" />
                  <TextBlock Text="档位 3" FontSize="11" Foreground="#6F8698" HorizontalAlignment="Center" Margin="0,5,0,0" />
                </StackPanel>
              </Border>
              <Border x:Name="Temp2" Grid.Column="4" Style="{StaticResource TileState}" Uid="5"
                      PreviewMouseLeftButtonDown="TileDown" MouseLeftButtonUp="TempClick" Tag="off">
                <StackPanel VerticalAlignment="Center">
                  <TextBlock x:Name="TempTitle2" Text="高温" FontSize="19" Foreground="#CFDDE8" HorizontalAlignment="Center" />
                  <TextBlock Text="档位 5" FontSize="11" Foreground="#6F8698" HorizontalAlignment="Center" Margin="0,5,0,0" />
                </StackPanel>
              </Border>
              <Border x:Name="BtnSleep" Grid.Column="6" Style="{StaticResource SmallTile}"
                      PreviewMouseLeftButtonDown="TileDown" MouseLeftButtonUp="SleepClick">
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="休眠" FontSize="19" Foreground="#CFDDE8" HorizontalAlignment="Center" />
                  <TextBlock Text="节电待机" FontSize="11" Foreground="#6F8698" HorizontalAlignment="Center" Margin="0,5,0,0" />
                </StackPanel>
              </Border>
            </Grid>

            <Border Grid.Row="4" CornerRadius="16" BorderThickness="1" BorderBrush="#18FFFFFF" Background="#12FFFFFF">
              <Grid Margin="18,0,18,0">
                <StackPanel VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="最近指令" FontSize="11" Foreground="#6F8698" VerticalAlignment="Center" />
                    <TextBlock x:Name="LastCmd" Text="—" FontSize="14" Foreground="#CFE2EE" Margin="10,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Text="·" FontSize="12" Foreground="#3F5566" Margin="10,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="LastRtt" Text="往返 —" FontSize="12" Foreground="#9FB4C6" VerticalAlignment="Center" />
                    <TextBlock Text="·" FontSize="12" Foreground="#3F5566" Margin="10,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="LastTime" Text="—" FontSize="12" Foreground="#9FB4C6" VerticalAlignment="Center" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                    <TextBlock Text="提示" FontSize="11" Foreground="#4E6373" VerticalAlignment="Center" />
                    <TextBlock x:Name="HintText" Text="启动后自动连接，空闲 30 秒自动断开" FontSize="12" Foreground="#7E93A6" Margin="10,0,0,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Border>
          </Grid>
        </Grid>

        <Grid x:Name="SettingsLayer" Grid.RowSpan="2" Visibility="Collapsed">
          <Border Background="#66000000" MouseLeftButtonUp="SettingsMaskClick" />

          <Border x:Name="SettingsPanel" Width="620" HorizontalAlignment="Center" VerticalAlignment="Center"
                  CornerRadius="20" BorderThickness="1" BorderBrush="#18FFFFFF">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF1F2A33" Offset="0" />
                <GradientStop Color="#FF12181F" Offset="1" />
              </LinearGradientBrush>
            </Border.Background>
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
                <RowDefinition Height="64" />
              </Grid.RowDefinitions>

              <Grid Grid.Row="0" Margin="24,0,16,0">
                <TextBlock Text="设置" FontSize="14" Foreground="#DCE9F3" VerticalAlignment="Center" />
                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Width="26" Height="26" CornerRadius="8"
                        Background="#14FFFFFF" BorderThickness="1" BorderBrush="#1FFFFFFF" Cursor="Hand"
                        PreviewMouseLeftButtonDown="TileDown" MouseLeftButtonUp="SettingsCloseClick">
                  <Canvas Width="9" Height="9">
                    <Line X1="0" Y1="0" X2="9" Y2="9" Stroke="#AFC4D4" StrokeThickness="1.3" />
                    <Line X1="9" Y1="0" X2="0" Y2="9" Stroke="#AFC4D4" StrokeThickness="1.3" />
                  </Canvas>
                </Border>
              </Grid>

              <StackPanel Grid.Row="1" Margin="24,0,24,0">
                <TextBlock Text="显示与布局" FontSize="11" Foreground="#7C93A6" Margin="0,4,0,10" />

                <Grid Height="56">
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="窗口不透明度" FontSize="13" Foreground="#DCE9F3" />
                    <TextBlock Text="仅作用于窗口背景玻璃层，不影响文字与状态色" FontSize="11" Foreground="#6F8698" Margin="0,5,0,0" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Slider x:Name="OpacitySlider" Width="166" Minimum="70" Maximum="100" Value="100"
                            TickFrequency="5" IsSnapToTickEnabled="True" Style="{StaticResource GlassSlider}"
                            ValueChanged="OpacityChanged" />
                    <TextBlock x:Name="OpacityVal" Text="100%" Width="88" Margin="12,0,0,0" TextAlignment="Right" FontSize="12"
                               Foreground="#DCE9F3" VerticalAlignment="Center" />
                  </StackPanel>
                </Grid>
                <Border Height="1" Background="#0FFFFFFF" />

                <Grid Height="56">
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="界面缩放" FontSize="13" Foreground="#DCE9F3" />
                    <TextBlock Text="整体缩放，窗口宽高同步变化并重新居中" FontSize="11" Foreground="#6F8698" Margin="0,5,0,0" />
                  </StackPanel>
                  <Border HorizontalAlignment="Right" VerticalAlignment="Center" Width="228" Height="32" CornerRadius="10"
                          Background="#0CFFFFFF" BorderThickness="1" BorderBrush="#12FFFFFF" Padding="3">
                    <UniformGrid Rows="1" Columns="4">
                      <Border x:Name="ScaleCell0" Style="{StaticResource SegCell}" Uid="0" BorderThickness="1" BorderBrush="Transparent"
                              PreviewMouseLeftButtonDown="TileDown" MouseLeftButtonUp="ScaleClick">
                        <TextBlock x:Name="ScaleText0" Text="100%" FontSize="12" Foreground="#8FA6B8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <Border x:Name="ScaleCell1" Style="{StaticResource SegCell}" Uid="1" BorderThickness="1" BorderBrush="Transparent"
                              PreviewMouseLeftButtonDown="TileDown" MouseLeftButtonUp="ScaleClick">
                        <TextBlock x:Name="ScaleText1" Text="115%" FontSize="12" Foreground="#8FA6B8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <Border x:Name="ScaleCell2" Style="{StaticResource SegCell}" Uid="2" BorderThickness="1" BorderBrush="Transparent"
                              PreviewMouseLeftButtonDown="TileDown" MouseLeftButtonUp="ScaleClick">
                        <TextBlock x:Name="ScaleText2" Text="130%" FontSize="12" Foreground="#8FA6B8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <Border x:Name="ScaleCell3" Style="{StaticResource SegCell}" Uid="3" BorderThickness="1" BorderBrush="Transparent"
                              PreviewMouseLeftButtonDown="TileDown" MouseLeftButtonUp="ScaleClick">
                        <TextBlock x:Name="ScaleText3" Text="150%" FontSize="12" Foreground="#8FA6B8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                    </UniformGrid>
                  </Border>
                </Grid>

                <TextBlock Text="连接行为" FontSize="11" Foreground="#7C93A6" Margin="0,12,0,10" />

                <Grid Height="56">
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="空闲自动断开" FontSize="13" Foreground="#DCE9F3" />
                    <TextBlock Text="空闲超时后释放蓝牙连接；调到 300 s 表示不自动断开" FontSize="11" Foreground="#6F8698" Margin="0,5,0,0" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Slider x:Name="IdleSlider" Width="166" Minimum="5" Maximum="300" Value="30"
                            TickFrequency="5" IsSnapToTickEnabled="True" Style="{StaticResource GlassSlider}"
                            ValueChanged="IdleChanged" />
                    <TextBlock x:Name="IdleVal" Text="30 s" Width="88" Margin="12,0,0,0" TextAlignment="Right" FontSize="12"
                               Foreground="#DCE9F3" VerticalAlignment="Center" />
                  </StackPanel>
                </Grid>
                <Border Height="1" Background="#0FFFFFFF" />

                <Grid Height="56">
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="状态轮询间隔" FontSize="13" Foreground="#DCE9F3" />
                    <TextBlock Text="调低更灵敏，但会增加蓝牙占用与丢帧风险" FontSize="11" Foreground="#6F8698" Margin="0,5,0,0" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Slider x:Name="PollSlider" Width="166" Minimum="300" Maximum="2000" Value="500"
                            TickFrequency="50" IsSnapToTickEnabled="True" Style="{StaticResource GlassSlider}"
                            ValueChanged="PollChanged" />
                    <TextBlock x:Name="PollVal" Text="500 ms" Width="88" Margin="12,0,0,0" TextAlignment="Right" FontSize="12"
                               Foreground="#DCE9F3" VerticalAlignment="Center" />
                  </StackPanel>
                </Grid>
                <Border Height="1" Background="#0FFFFFFF" />

                <Grid Height="88">
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="目标设备" FontSize="13" Foreground="#DCE9F3" />
                    <TextBlock x:Name="BindDesc" Text="自动扫描首个 JOMOO_SMART 设备" FontSize="11" Foreground="#6F8698" Margin="0,5,0,0" />
                  </StackPanel>
                  <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border HorizontalAlignment="Right" Width="150" Height="30" CornerRadius="10" Background="#0CFFFFFF"
                            BorderThickness="1" BorderBrush="#12FFFFFF" Padding="3">
                      <UniformGrid Rows="1" Columns="2">
                        <Border x:Name="BindAutoCell" Style="{StaticResource SegCell}" BorderThickness="1" BorderBrush="Transparent"
                                PreviewMouseLeftButtonDown="TileDown" MouseLeftButtonUp="BindAutoClick">
                          <TextBlock x:Name="BindAutoText" Text="自动" FontSize="12" Foreground="#8FA6B8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border x:Name="BindMacCell" Style="{StaticResource SegCell}" BorderThickness="1" BorderBrush="Transparent"
                                PreviewMouseLeftButtonDown="TileDown" MouseLeftButtonUp="BindMacClick">
                          <TextBlock x:Name="BindMacText" Text="指定" FontSize="12" Foreground="#8FA6B8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                      </UniformGrid>
                    </Border>
                    <Border x:Name="TargetBox" Width="268" Height="30" CornerRadius="9" Background="#0FFFFFFF" BorderThickness="1"
                            BorderBrush="#14FFFFFF" Margin="0,8,0,0" Cursor="Hand"
                            PreviewMouseLeftButtonDown="TileDown" MouseLeftButtonUp="TargetBoxClick">
                      <Grid Margin="10,0,8,0">
                        <TextBlock x:Name="TargetText" Text="未指定 · 点此选择设备" FontSize="12" Foreground="#8FA6B8"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Path Data="M 0,0 L 5,5 L 10,0" Stroke="#7C93A6" StrokeThickness="1.2" Width="10" Height="5"
                              HorizontalAlignment="Right" VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                  </StackPanel>
                </Grid>

                <TextBlock Text="诊断" FontSize="11" Foreground="#7C93A6" Margin="0,12,0,10" />

                <Grid Height="56">
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="日志记录" FontSize="13" Foreground="#DCE9F3" />
                    <TextBlock Text="记录连接、指令与异常，排查时提供给开发者" FontSize="11" Foreground="#6F8698" Margin="0,5,0,0" />
                  </StackPanel>
                  <Grid Width="42" Height="22" HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand"
                        PreviewMouseLeftButtonDown="TileDown" MouseLeftButtonUp="LogToggleClick">
                    <Border x:Name="LogTrack" Width="40" Height="20" CornerRadius="10" Background="#22FFFFFF"
                            BorderThickness="1" BorderBrush="#1FFFFFFF">
                      <Ellipse x:Name="LogKnob" Width="14" Height="14" Fill="#7C93A6" HorizontalAlignment="Left" Margin="2,0,0,0" />
                    </Border>
                  </Grid>
                </Grid>
                <Border Height="1" Background="#0FFFFFFF" />

                <Grid Height="56">
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="日志目录" FontSize="13" Foreground="#DCE9F3" />
                    <TextBlock x:Name="LogDirText" Text="%APPDATA%\JomooRemote\logs" FontSize="11" Foreground="#6F8698"
                               Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <Border HorizontalAlignment="Right" VerticalAlignment="Center" Width="76" Height="30" CornerRadius="9"
                          Background="#0FFFFFFF" BorderThickness="1" BorderBrush="#1FFFFFFF" Cursor="Hand"
                          PreviewMouseLeftButtonDown="TileDown" MouseLeftButtonUp="OpenLogDirClick">
                    <TextBlock Text="打开目录" FontSize="12" Foreground="#C9D8E4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                </Grid>

                <TextBlock x:Name="SettingsHint" Text="" FontSize="11" Foreground="#7C93A6" Margin="0,6,0,0" MinHeight="16" />
              </StackPanel>

              <Grid Grid.Row="2" Margin="24,0,24,0">
                <Border Height="1" Background="#0FFFFFFF" VerticalAlignment="Top" />
                <Border x:Name="ResetButton" Style="{StaticResource PanelBtn}" HorizontalAlignment="Left" VerticalAlignment="Center"
                        PreviewMouseLeftButtonDown="TileDown" MouseLeftButtonUp="ResetSettingsClick">
                  <TextBlock Text="恢复默认" FontSize="12" Foreground="#C9D8E4" VerticalAlignment="Center" />
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                  <Border Style="{StaticResource PanelBtn}" Margin="0,0,10,0"
                          PreviewMouseLeftButtonDown="TileDown" MouseLeftButtonUp="CancelSettingsClick">
                    <TextBlock Text="取消" FontSize="12" Foreground="#C9D8E4" VerticalAlignment="Center" />
                  </Border>
                  <Border Style="{StaticResource PanelBtn}" Background="#1757C8FF" BorderBrush="#3D57C8FF"
                          PreviewMouseLeftButtonDown="TileDown" MouseLeftButtonUp="SaveSettingsClick">
                    <TextBlock Text="保存" FontSize="12" Foreground="#BFE6FB" VerticalAlignment="Center" />
                  </Border>
                </StackPanel>
              </Grid>
            </Grid>
          </Border>

          <Border x:Name="DeviceSheet" Visibility="Collapsed" Width="420" CornerRadius="16" Background="#FF0A1119"
                  BorderThickness="1" BorderBrush="#2EFFFFFF" Padding="18,14" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
              <TextBlock Text="选择目标设备" FontSize="13" Foreground="#DCE9F3" />
              <TextBlock x:Name="ScanState" Text="扫描中…" FontSize="11" Foreground="#6F8698" Margin="0,6,0,10" />
              <StackPanel x:Name="DevicesList" />
              <Border HorizontalAlignment="Right" Margin="0,12,0,0" Style="{StaticResource PanelBtn}" Height="32"
                      PreviewMouseLeftButtonDown="TileDown" MouseLeftButtonUp="DeviceSheetCancelClick">
                <TextBlock Text="取消" FontSize="12" Foreground="#C9D8E4" VerticalAlignment="Center" />
              </Border>
            </StackPanel>
          </Border>
        </Grid>
      </Grid>

      <Popup x:Name="FaultPopup" PlacementTarget="{Binding ElementName=FaultCell}" Placement="Bottom"
             StaysOpen="True" AllowsTransparency="True" IsHitTestVisible="False" VerticalOffset="6">
        <Border Background="#FF0A1119" CornerRadius="12" BorderThickness="1" BorderBrush="#2EFFFFFF" Padding="14,10">
          <StackPanel x:Name="FaultList" MaxWidth="330" />
        </Border>
      </Popup>
    </Grid>
  </Grid>
</Window>
